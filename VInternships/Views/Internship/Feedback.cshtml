@model FeedbackForm
@{ ViewData["Title"]="Supervisor feedback"; }
<div class="page-heading"><div><p class="eyebrow">PLACEMENT FEEDBACK</p><h1>Supervisor feedback</h1><p>@Model.Placement.Student.Name · @Model.Placement.Placement.Position</p></div></div>
<form asp-action="Feedback" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div class="field"><label asp-for="Feedback"></label><textarea asp-for="Feedback" class="form-control" rows="6" maxlength="1000" aria-describedby="feedback-help"></textarea><span asp-validation-for="Feedback" class="field-error"></span><small id="feedback-help">Use fictional feedback, up to 1,000 characters. Leave blank to clear the saved feedback.</small></div><div class="actions"><button type="submit" class="btn btn-primary">Save feedback</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div></form>
