@model PlacementForm
@{ var editing=Model.Id.Length>0;var action=editing?"Edit":"Create";ViewData["Title"]=(editing?"Edit":"Create")+" placement"; }
<div class="page-heading"><div><p class="eyebrow">PLACEMENTS</p><h1>@ViewData["Title"]</h1><p>Choose saved records. Hours and feedback are managed from the placement details page.</p></div></div>
<form asp-action="@action" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
<div class="field"><label asp-for="StudentId"></label><select asp-for="StudentId" class="form-select"><option value="">Choose a student</option>@foreach(var student in Model.Students) { <option value="@student.Id">@student.Name</option> }</select><span asp-validation-for="StudentId" class="field-error"></span><small>Missing a student? <a asp-controller="Student" asp-action="Create">Add a fictional student</a>.</small></div>
<div class="field"><label asp-for="CompanyId"></label><select asp-for="CompanyId" class="form-select"><option value="">Choose a company</option>@foreach(var company in Model.Companies) { <option value="@company.Id">@company.Name · @company.Location</option> }</select><span asp-validation-for="CompanyId" class="field-error"></span><small>Missing a company? <a asp-controller="Company" asp-action="Create">Add a fictional company</a>.</small></div>
<div class="field"><label asp-for="Position"></label><input asp-for="Position" class="form-control" maxlength="100" /><span asp-validation-for="Position" class="field-error"></span></div>
<div class="form-columns"><div class="field"><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" class="form-control" min="2000-01-01" max="2100-12-31" /><span asp-validation-for="StartDate" class="field-error"></span></div><div class="field"><label asp-for="EndDate"></label><input asp-for="EndDate" type="date" class="form-control" min="2000-01-01" max="2100-12-31" /><span asp-validation-for="EndDate" class="field-error"></span></div></div>
<p class="muted">The end must be on or after the start, within a maximum duration of 730 days. Dates use UTC for placement status.</p>
<div class="actions"><button class="btn btn-primary" type="submit">Save placement</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form>
