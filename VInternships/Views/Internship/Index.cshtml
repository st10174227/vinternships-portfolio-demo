@model IReadOnlyList<PlacementRow>
@{ ViewData["Title"]="Placements"; }
<div class="page-heading"><div><p class="eyebrow">PLACEMENT REGISTER</p><h1>Placements</h1><p>Open a placement to log hours, record feedback or update its details.</p></div><a class="btn btn-primary" asp-action="Create">Create placement</a></div>
<div class="panel table-responsive desktop-records"><table class="table"><caption class="visually-hidden">Sample internship placements</caption><thead><tr><th>Student / position</th><th>Company</th><th>Dates</th><th>Status</th><th>Hours</th><th>Actions</th></tr></thead><tbody>
@foreach(var row in Model) { <tr><td><strong>@row.Student.Name</strong><span class="cell-note">@row.Placement.Position</span></td><td>@row.Company.Name</td><td class="date-cell">@row.Placement.StartDate.ToString("dd MMM yyyy")<span class="cell-note">to @row.Placement.EndDate.ToString("dd MMM yyyy")</span></td><td><span class="status @row.Status.ToLowerInvariant()">@row.Status</span></td><td>@row.Placement.HoursLogged</td><td><div class="row-actions"><a asp-action="Details" asp-route-id="@row.Placement.Id">Open</a><a asp-action="Edit" asp-route-id="@row.Placement.Id">Edit</a></div></td></tr> }
</tbody></table></div>
<section class="mobile-records" aria-label="Sample placements">
@foreach(var row in Model) {
<article class="mobile-record">
<div class="record-heading"><h2>@row.Student.Name</h2><span class="status @row.Status.ToLowerInvariant()">@row.Status</span></div>
<p class="record-position">@row.Placement.Position</p>
<dl class="record-meta"><div><dt>Company</dt><dd>@row.Company.Name</dd></div><div><dt>Dates</dt><dd>@row.Placement.StartDate.ToString("dd MMM yyyy") <span>to</span> @row.Placement.EndDate.ToString("dd MMM yyyy")</dd></div><div><dt>Hours logged</dt><dd>@row.Placement.HoursLogged hours</dd></div></dl>
<div class="record-actions"><a class="btn btn-primary" asp-controller="Internship" asp-action="Details" asp-route-id="@row.Placement.Id">Open placement<span class="visually-hidden"> for @row.Student.Name</span></a><a class="btn btn-outline-primary" asp-controller="Internship" asp-action="Edit" asp-route-id="@row.Placement.Id">Edit<span class="visually-hidden"> placement for @row.Student.Name</span></a></div>
</article>
}
</section>
@if(Model.Count==0) { <p class="empty-state">No placements match this view. Create a sample placement or <a asp-action="Index">view all placements</a>.</p> }
