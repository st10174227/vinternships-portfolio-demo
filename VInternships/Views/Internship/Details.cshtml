@model PlacementRow
@{ ViewData["Title"]="Placement details"; }
<div class="page-heading"><div><p class="eyebrow">PLACEMENT DETAILS</p><h1>@Model.Placement.Position</h1><p>@Model.Student.Name at @Model.Company.Name</p></div><span class="status @Model.Status.ToLowerInvariant()">@Model.Status</span></div>
<div class="detail-layout"><section class="panel detail-panel"><h2>The placement</h2><dl class="detail-grid"><div><dt>Student</dt><dd><a asp-controller="Student" asp-action="Details" asp-route-id="@Model.Student.Id">@Model.Student.Name</a></dd></div><div><dt>Company</dt><dd><a asp-controller="Company" asp-action="Details" asp-route-id="@Model.Company.Id">@Model.Company.Name</a></dd></div><div><dt>Start date</dt><dd>@Model.Placement.StartDate.ToString("dd MMM yyyy")</dd></div><div><dt>End date</dt><dd>@Model.Placement.EndDate.ToString("dd MMM yyyy")</dd></div><div><dt>Location</dt><dd>@Model.Company.Location</dd></div><div><dt>Hours logged</dt><dd><strong data-hours="@Model.Placement.HoursLogged">@Model.Placement.HoursLogged hours</strong></dd></div></dl><div class="actions"><a class="btn btn-primary" asp-action="LogHours" asp-route-id="@Model.Placement.Id">Add hours</a><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Placement.Id">Edit placement</a></div></section>
<section class="panel detail-panel"><h2>Supervisor feedback</h2>@if(string.IsNullOrEmpty(Model.Placement.SupervisorFeedback)) { <p class="muted">No feedback recorded yet.</p> } else { <p class="feedback-text">@Model.Placement.SupervisorFeedback</p> }<a class="btn btn-outline-primary" asp-action="Feedback" asp-route-id="@Model.Placement.Id">Update feedback</a><p class="small-note">Fictional feedback for this demo. No supervisor is contacted.</p></section></div>
<div class="actions page-end"><a asp-action="Index">← All placements</a><a class="danger-link" asp-action="Delete" asp-route-id="@Model.Placement.Id">Delete placement</a></div>
