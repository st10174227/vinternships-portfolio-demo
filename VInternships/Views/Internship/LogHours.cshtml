@model HoursForm
@{ ViewData["Title"]="Add hours"; }
<div class="page-heading"><div><p class="eyebrow">PLACEMENT HOURS</p><h1>Add hours</h1><p>@Model.Placement.Student.Name · @Model.Placement.Placement.Position</p></div></div>
<form asp-action="LogHours" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><p class="current-total">Current total <strong data-hours="@Model.Placement.Placement.HoursLogged">@Model.Placement.Placement.HoursLogged hours</strong></p><div class="field"><label asp-for="HoursToAdd"></label><input asp-for="HoursToAdd" class="form-control" type="number" min="1" max="24" step="1" /><span asp-validation-for="HoursToAdd" class="field-error"></span><small>Add 1–24 whole hours. This adds to the current total.</small></div><p class="muted">The total is limited to 2,000 hours and cannot exceed the hours available in the placement's date range.</p><div class="actions"><button type="submit" class="btn btn-primary">Add hours</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div></form>
