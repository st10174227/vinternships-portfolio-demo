@model Company
@{ ViewData["Title"]="Company details"; }
<div class="page-heading"><div><p class="eyebrow">COMPANY PROFILE</p><h1>@Model.Name</h1></div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit details</a></div>
<section class="panel detail-panel"><dl class="detail-grid"><div><dt>Name</dt><dd>@Model.Name</dd></div><div><dt>Industry</dt><dd>@Model.Industry</dd></div><div><dt>Location</dt><dd>@Model.Location</dd></div><div><dt>Contact email</dt><dd>@Model.ContactEmail</dd></div><div><dt>Placements</dt><dd>@ViewData["PlacementCount"]</dd></div></dl><div class="actions"><a class="btn btn-primary" asp-controller="Internship" asp-action="Index" asp-route-companyId="@Model.Id">View placements</a><a class="btn btn-outline-secondary" asp-action="Index">Back to companies</a></div></section>
