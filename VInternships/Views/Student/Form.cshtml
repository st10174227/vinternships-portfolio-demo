@model StudentForm
@{ var editing=Model.Id.Length>0;var action=editing?"Edit":"Create";ViewData["Title"]=(editing?"Edit":"Add")+" student"; }
<div class="page-heading"><div><p class="eyebrow">STUDENTS</p><h1>@ViewData["Title"]</h1><p>Use fictional details. Nothing here contacts a real person.</p></div></div>
<form asp-action="@action" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
<div class="field"><label asp-for="Name"></label><input asp-for="Name" type="text" class="form-control" maxlength="80" /><span asp-validation-for="Name" class="field-error"></span></div>
<div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" class="form-control" maxlength="160" /><span asp-validation-for="Email" class="field-error"></span></div>
<div class="field"><label asp-for="DegreeProgram"></label><input asp-for="DegreeProgram" type="text" class="form-control" maxlength="100" /><span asp-validation-for="DegreeProgram" class="field-error"></span></div>
<div class="field"><label asp-for="YearOfStudy"></label><input asp-for="YearOfStudy" type="number" class="form-control" min="1" max="6" step="1" /><span asp-validation-for="YearOfStudy" class="field-error"></span></div>
<div class="actions"><button class="btn btn-primary" type="submit">Save student</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form>
