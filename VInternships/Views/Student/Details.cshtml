@model Student
@{ ViewData["Title"]="Student details"; }
<div class="page-heading"><div><p class="eyebrow">STUDENT PROFILE</p><h1>@Model.Name</h1></div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit details</a></div>
<section class="panel detail-panel"><dl class="detail-grid"><div><dt>Name</dt><dd>@Model.Name</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Degree programme</dt><dd>@Model.DegreeProgram</dd></div><div><dt>Year of study</dt><dd>@Model.YearOfStudy</dd></div><div><dt>Placements</dt><dd>@ViewData["PlacementCount"]</dd></div></dl><div class="actions"><a class="btn btn-primary" asp-controller="Internship" asp-action="Index" asp-route-studentId="@Model.Id">View placements</a><a class="btn btn-outline-secondary" asp-action="Index">Back to students</a></div></section>
