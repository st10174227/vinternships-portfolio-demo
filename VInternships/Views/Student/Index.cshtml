@model IReadOnlyList<Student>
@{ ViewData["Title"]="Students"; }
<div class="page-heading"><div><p class="eyebrow">DIRECTORY</p><h1>Students</h1><p>Keep student details and placement records connected.</p></div><a class="btn btn-primary" asp-action="Create">Add student</a></div>
<div class="panel table-responsive desktop-records"><table class="table"><caption class="visually-hidden">Sample students</caption><thead><tr><th>Student</th><th>Programme</th><th>Year</th><th>Actions</th></tr></thead><tbody>
@foreach(var record in Model) { <tr><td><strong>@record.Name</strong><span class="cell-note">@record.Email</span></td><td>@record.DegreeProgram</td><td>@record.YearOfStudy</td><td><div class="row-actions"><a asp-action="Details" asp-route-id="@record.Id">Details</a><a asp-action="Edit" asp-route-id="@record.Id">Edit</a><a class="danger-link" asp-action="Delete" asp-route-id="@record.Id">Delete</a></div></td></tr> }
</tbody></table></div>
<section class="mobile-records" aria-label="Sample student records">
@foreach(var record in Model) {
<article class="mobile-record"><h2 class="record-name">@record.Name</h2><dl class="record-meta"><div><dt>Email</dt><dd>@record.Email</dd></div><div><dt>Programme</dt><dd>@record.DegreeProgram</dd></div><div><dt>Year of study</dt><dd>@record.YearOfStudy</dd></div></dl><div class="record-actions"><a class="btn btn-primary" asp-action="Details" asp-route-id="@record.Id">Details<span class="visually-hidden"> for @record.Name</span></a><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@record.Id">Edit<span class="visually-hidden"> @record.Name</span></a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@record.Id">Delete<span class="visually-hidden"> @record.Name</span></a></div></article>
}
</section>
@if(Model.Count==0) { <p class="empty-state">No records yet. Add a fictional record to begin.</p> }
