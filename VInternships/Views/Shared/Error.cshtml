@model ErrorViewModel
@{ ViewData["Title"]="Something went wrong"; }
<section class="panel detail-panel"><h1>We could not complete that request.</h1><p>Return to your workspace and try again. This is a temporary sample environment.</p>@if(Model.ShowRequestId) { <p class="muted">Reference: @Model.RequestId</p> }<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Open overview</a></section>
